# Copy to backend/.env and fill in. Never commit .env.
# Values in this file take precedence over variables set in your shell.

# PostgreSQL (native install) — SQLAlchemy URL using the psycopg 3 driver.
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/bookmind

# ---------------------------------------------------------------- AI model
# ollama    = local and free, works fully offline, no API key (default). Install: https://ollama.com/download
# gemini    = Google Gemini (needs GEMINI_API_KEY)
# anthropic = Anthropic Claude (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=ollama

# Empty = provider default (ollama: qwen2.5:3b, gemini: gemini-2.5-flash, anthropic: claude-opus-5-5).
# Ollama suggestions by RAM: 8 GB -> qwen2.5:3b or llama3.2:3b; 16 GB -> llama3.1:8b or qwen2.5:7b.
# Pull the model first:  ollama pull qwen2.5:3b
LLM_MODEL=qwen2.5:3b
# Optional cheaper/faster model for background jobs (analysis, quizzes). Empty = LLM_MODEL.
# LLM_FAST_MODEL=

# Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192          # context window in tokens; lower it if Ollama runs out of memory
# OLLAMA_KEEP_ALIVE=30m        # keep the model loaded between questions

# Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=

# Anthropic (https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# LLM_CHAT_EFFORT=low
# LLM_TASK_EFFORT=low
# LLM_REFUSAL_FALLBACK=true

# Shared LLM settings
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=600      # local models on a CPU can be slow
# LLM_JSON_RETRIES=2           # extra attempts when a model returns invalid JSON
# QUERY_REWRITE=auto           # auto | llm | heuristic | off (follow-up question handling)

# ---------------------------------------------------------------- Embeddings (always local)
# Changing the model/dimension requires a fresh database (or a new migration) + re-index.
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Chunking (approximate tokens)
# CHUNK_TARGET_TOKENS=500
# CHUNK_MAX_TOKENS=700
# CHUNK_OVERLAP_TOKENS=80

# Retrieval
# RETRIEVAL_CANDIDATES=40
# RETRIEVAL_TOP_K=0            # passages sent to the model; 0 = auto (5 local, 8 cloud)

# MAX_UPLOAD_MB=200
# HOST=127.0.0.1
# PORT=8000
