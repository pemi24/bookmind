# Copy to backend/.env and fill in. Never commit .env.
# Values in this file take precedence over variables set in your shell.

# PostgreSQL (native install) — SQLAlchemy URL using the psycopg 3 driver.
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/bookmind

# ---------------------------------------------------------------- AI model
# ollama    = local and free, works fully offline, no API key (default). Install: https://ollama.com/download
# gemini    = Google Gemini (needs GEMINI_API_KEY)
# anthropic = Anthropic Claude (needs ANTHROPIC_API_KEY)
# groq      = Groq, free plan, very fast (needs GROQ_API_KEY)
# openrouter = OpenRouter free models (needs OPENROUTER_API_KEY; only models ending in ":free" are used)
LLM_PROVIDER=ollama

# Empty = provider default (ollama: qwen2.5:3b, gemini: gemini-3.5-flash, anthropic: claude-opus-5-5).
# Ollama suggestions by RAM: 8 GB -> qwen2.5:3b or llama3.2:3b; 16 GB -> llama3.1:8b or qwen2.5:7b.
# Pull the model first:  ollama pull qwen2.5:3b
LLM_MODEL=qwen2.5:3b
# Optional cheaper/faster model for background jobs (analysis, quizzes). Empty = LLM_MODEL.
# LLM_FAST_MODEL=

# Ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=8192          # context window in tokens; lower it if Ollama runs out of memory
# OLLAMA_KEEP_ALIVE=30m        # keep the model loaded between questions

# Gemini (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # used if the main model stays overloaded; empty = off
#                                                 # (with LLM_FALLBACKS, only for quick background tasks)

# Backup providers, tried in order when the main one's free quota is used up, it's overloaded,
# or it refuses an answer. A used-up daily quota is skipped until it resets.
# LLM_FALLBACKS=groq,openrouter
# Groq (https://console.groq.com/keys): ~1,000 requests/day free; very fast
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (https://openrouter.ai/keys): free models, 50 requests/day (1,000 after a one-time $10 top-up)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Anthropic (https://console.anthropic.com)
# ANTHROPIC_API_KEY=
# LLM_CHAT_EFFORT=low
# LLM_TASK_EFFORT=low
# LLM_REFUSAL_FALLBACK=true

# Shared LLM settings
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=600      # local models on a CPU can be slow
# LLM_JSON_RETRIES=2           # extra attempts when a model returns invalid JSON
# QUERY_REWRITE=auto           # auto | llm | heuristic | off (follow-up question handling)

# ---------------------------------------------------------------- Embeddings (always local)
# Changing the model/dimension requires a fresh database (or a new migration) + re-index.
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIM=384
# RERANK_ENABLED=true
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Chunking (approximate tokens)
# CHUNK_TARGET_TOKENS=500
# CHUNK_MAX_TOKENS=700
# CHUNK_OVERLAP_TOKENS=80

# Retrieval
# RETRIEVAL_CANDIDATES=40
# RETRIEVAL_TOP_K=0            # passages sent to the model; 0 = auto (5 local, 8 cloud)

# MAX_UPLOAD_MB=200
# HOST=127.0.0.1
# PORT=8000

# ---------------------------------------------------------------- Accounts
# Everyone signs in with an email and password; each account has its own private library.
# Sessions are stored in PostgreSQL; browsers only get a random token in an HttpOnly cookie.
# SESSION_HOURS=12                 # signed in without "Keep me signed in" (renewed while in use)
# REMEMBER_DAYS=30                 # with "Keep me signed in"
# COOKIE_SECURE=auto               # auto = Secure cookies over HTTPS only | true | false
# PASSWORD_MIN_LENGTH=10
# REQUIRE_EMAIL_VERIFICATION=false # true = new accounts must click a link before signing in
# RESET_TOKEN_MINUTES=30           # how long a password-reset link works
# VERIFY_TOKEN_HOURS=48

# Brute-force protection (attempts per IP address and per email)
# LOGIN_RATE_LIMIT=10              # per 15 minutes
# SIGNUP_RATE_LIMIT=5              # per hour
# RESET_RATE_LIMIT=5               # per hour
# LOCKOUT_AFTER_FAILURES=5         # wrong passwords in a row before a short lockout

# First admin. When the accounts migration runs, everything that already exists (books, chats,
# notes...) is given to this account. Set its password afterwards with:
#   python scripts/create_admin.py
# ADMIN_EMAIL=admin@localhost
# ADMIN_PASSWORD=                  # optional: set it here before the migration instead

# Per-account limits (0 = unlimited). MAX_UPLOAD_MB above applies per file.
# MAX_BOOKS_PER_USER=50
# DAILY_MESSAGE_LIMIT=300          # chat questions per rolling 24 hours

# Email (password reset, email verification, "your email was changed" notices)
# EMAIL_BACKEND=console            # console = printed in the backend's terminal (fine at home) | smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=                   # for Gmail, an "app password", not your normal password
# SMTP_FROM=BookMind <no-reply@localhost>
# SMTP_TLS=true
# APP_BASE_URL=                    # address used in email links; empty = the address the request came to
